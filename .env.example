# ---- Basis data ----
# Lokal: SQLite file. Produksi: gunakan Turso (libsql) dengan TURSO_DATABASE_URL + TURSO_AUTH_TOKEN.
DATABASE_URL="file:./dev.db"
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ---- Auth.js ----
# Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-rahasia-acak"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ----
# Authorized redirect URI: https://DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Client ID yang sama dipakai Google One Tap di sisi klien
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ---- Administrator awal ----
# Email Google yang otomatis menjadi ADMIN aktif saat pertama masuk (pisahkan dengan koma)
ADMIN_EMAILS="m.reza.086@gmail.com"
# Batasi login hanya untuk domain email tertentu (opsional, pisahkan dengan koma). Kosongkan untuk semua domain.
ALLOWED_EMAIL_DOMAINS=""

# ---- Mode demo ----
# Jika "true", tersedia tombol masuk cepat sebagai akun contoh (tanpa Google). Matikan di produksi.
DEMO_MODE="true"

# ---- Cron pengingat (opsional) ----
CRON_SECRET=""
