# ---- Basis data (PostgreSQL) ----
# Lokal: PostgreSQL sendiri. Di Vercel, integrasi Prisma Postgres menyuntikkan DATABASE_URL otomatis
# (nama lain yang juga dikenali: PRISMA_DATABASE_URL, POSTGRES_URL, POSTGRES_PRISMA_URL; untuk migrasi:
# DIRECT_URL / POSTGRES_URL_NON_POOLING bila ada).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/peduli"

# ---- Auth.js ----
# Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-rahasia-acak"
# Alamat publik aplikasi (di Vercel boleh dikosongkan, dideteksi otomatis)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ----
# Authorized redirect URI: https://DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Client ID yang sama dipakai Google One Tap di sisi klien
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ---- Administrator awal ----
# Email Google yang otomatis menjadi ADMIN aktif saat pertama masuk (pisahkan dengan koma)
ADMIN_EMAILS="m.reza.086@gmail.com"
# Batasi login hanya untuk domain email tertentu (opsional, pisahkan dengan koma). Kosongkan untuk semua domain.
ALLOWED_EMAIL_DOMAINS=""

# ---- Mode demo ----
# Jika "true", tersedia tombol masuk cepat sebagai akun contoh (tanpa Google). Matikan di produksi.
DEMO_MODE="true"

# ---- Seed ----
# "false" = hanya pengaturan, area, dan katalog reward (tanpa akun demo dan laporan contoh). Dipakai untuk produksi.
SEED_DEMO="true"

# ---- Cron pengingat ----
# Wajib diisi; Vercel Cron mengirim header Authorization: Bearer CRON_SECRET secara otomatis.
CRON_SECRET=""
