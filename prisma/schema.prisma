// PEDULI Apps - skema data
// Pelaporan Bahaya dan Upaya Pengendalian - PT. Garuda Yamato Steel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime memakai URL yang dipilih di src/lib/db.ts; CLI memakai DATABASE_URL (lihat scripts/migrate.mjs)
  url      = env("DATABASE_URL")
}

// ---------- Autentikasi (Auth.js) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Profil organisasi
  role       String   @default("PENGAWAS") // ADMIN | DIREKSI | MANAGER | SUPERINTENDENT | PENGAWAS
  status     String   @default("PENDING")  // PENDING | ACTIVE | INACTIVE
  nik        String?  @unique
  jabatan    String?
  departemen String?
  phone      String?
  areaId     String?
  area       Area?    @relation("UserArea", fields: [areaId], references: [id])
  atasanId   String?  // Superintendent bagi Pengawas, Manager bagi Superintendent
  atasan     User?    @relation("Atasan", fields: [atasanId], references: [id])
  bawahan    User[]   @relation("Atasan")

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  reports        Report[]      @relation("Reporter")
  verifications  Report[]      @relation("Verifier")
  decisions      Report[]      @relation("Decider")
  picReports     Report[]      @relation("Pic")
  closures       Report[]      @relation("Closer")
  events         ReportEvent[]
  pointLedger    PointLedger[]
  redemptions    Redemption[]  @relation("Redeemer")
  processed      Redemption[]  @relation("Processor")
  auditLogs      AuditLog[]
  notifications  Notification[]
  managedAreas   Area[]        @relation("AreaManager")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Master ----------

model Area {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  lat       Float?
  lng       Float?
  radiusM   Int     @default(300)
  managerId String?
  manager   User?   @relation("AreaManager", fields: [managerId], references: [id])
  active    Boolean @default(true)
  createdAt DateTime @default(now())

  users   User[]   @relation("UserArea")
  reports Report[]
}

// ---------- Laporan ----------

model Report {
  id     String @id @default(cuid())
  number String @unique // PDL-202610-0001

  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id])
  path       String // A = via verifikasi Superintendent, B = langsung ke Manager

  areaId    String?
  area      Area?   @relation(fields: [areaId], references: [id])
  areaLabel String? // lokasi spesifik yang ditulis pelapor

  category  String // KONDISI_TIDAK_AMAN | TINDAKAN_TIDAK_AMAN | NYARIS_CELAKA | ERGONOMI | LINGKUNGAN
  riskLevel String // RENDAH | SEDANG | TINGGI | EKSTREM
  description String  @db.Text // tindakan atau kondisi tidak aman yang diobservasi
  suggestion  String? @db.Text // tindakan pencegahan agar tidak terulang (usulan, bonus poin bila diterapkan)

  // Kartu STOP (DuPont)
  stopItems       String[] @default([]) // kunci item daftar periksa STOP (lihat STOP_GROUPS)
  activities      String[] @default([]) // aktivitas yang diobservasi
  safeActs        String?  @db.Text     // tindakan aman yang diobservasi
  safeEncourage   String?  @db.Text     // tindakan untuk mendorong kinerja aman
  immediateAction String?  @db.Text     // tindakan perbaikan yang langsung dilakukan

  lat         Float?
  lng         Float?
  accuracyM   Float?
  outsideArea Boolean @default(false)
  locationFlag String? // catatan bila lokasi mencurigakan

  clientCreatedAt DateTime?
  syncedOffline   Boolean   @default(false)
  clientId        String?   @unique // kunci idempoten pengiriman dari perangkat (antrean luring)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  status String // MENUNGGU_VERIFIKASI | PERLU_REVISI | DITOLAK | MENUNGGU_KEPUTUSAN | DALAM_PERBAIKAN | MENUNGGU_PENUTUPAN | SELESAI
  escalated Boolean @default(false)

  dueVerifyAt DateTime?
  dueDecideAt DateTime?

  // Verifikasi Superintendent
  verifierId         String?
  verifier           User?     @relation("Verifier", fields: [verifierId], references: [id])
  verifiedAt         DateTime?
  verificationResult String?   // VALID | REVISI | TOLAK
  verificationNote   String?
  revisionCount      Int       @default(0)

  // Keputusan Manager
  deciderId        String?
  decider          User?     @relation("Decider", fields: [deciderId], references: [id])
  decidedAt        DateTime?
  decisionResult   String?   // SETUJU | TOLAK
  decisionNote     String?
  picId            String?
  pic              User?     @relation("Pic", fields: [picId], references: [id])
  picName          String?
  resourceTenaga   String?
  resourceBiaya    String?
  resourceMaterial String?
  targetDate       DateTime?
  controlHierarchy String?   // ELIMINASI | SUBSTITUSI | REKAYASA_TEKNIK | ADMINISTRATIF | APD
  suggestionApplied Boolean  @default(false)

  // Perbaikan dan penutupan
  progressPct     Int       @default(0)
  completedAt     DateTime? // PIC melaporkan selesai
  completionNote  String?
  closerId        String?
  closer          User?     @relation("Closer", fields: [closerId], references: [id])
  closedAt        DateTime?
  closureNote     String?
  closedOnTime    Boolean?

  isDuplicate   Boolean @default(false)
  duplicateOfId String?

  pointsAwarded Int     @default(0)
  auditSampled  Boolean @default(false)

  photos Photo[]
  events ReportEvent[]
  ledger PointLedger[]

  @@index([status])
  @@index([reporterId])
  @@index([areaId])
  @@index([createdAt])
}

model Photo {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind      String   @default("LAPORAN") // LAPORAN | PERBAIKAN
  mime      String
  data      Bytes
  thumb     Bytes? // gambar kecil untuk daftar
  width     Int?
  height    Int?
  size      Int
  createdAt DateTime @default(now())

  @@index([reportId])
}

model ReportEvent {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  type       String   // DIBUAT | DIVERIFIKASI | DIREVISI | DITOLAK | DIPUTUSKAN | PROGRES | SELESAI_PERBAIKAN | DITUTUP | DIESKALASI | PENGINGAT | REVISI_DIKIRIM
  fromStatus String?
  toStatus   String?
  note       String?  @db.Text
  meta       String?  @db.Text // JSON
  createdAt  DateTime @default(now())

  @@index([reportId])
}

// ---------- Poin dan reward ----------

model PointLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId  String?
  report    Report?  @relation(fields: [reportId], references: [id])
  type      String   // LAPORAN_VALID | NYARIS_CELAKA | BONUS_RISIKO | BONUS_USULAN | BONUS_KONSISTEN | PENUKARAN | PENYESUAIAN | PEMBATALAN
  points    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, type])
}

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String?
  pointsCost  Int
  stock       Int      @default(0)
  tier        String   @default("AWAL") // AWAL | MENENGAH | LANJUT
  icon        String?  // nama ikon lucide
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  redemptions Redemption[]
}

model Redemption {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("Redeemer", fields: [userId], references: [id])
  rewardId      String
  reward        Reward    @relation(fields: [rewardId], references: [id])
  pointsCost    Int
  status        String    @default("DIAJUKAN") // DIAJUKAN | DIPROSES | SELESAI | DITOLAK
  note          String?
  processedById String?
  processedBy   User?     @relation("Processor", fields: [processedById], references: [id])
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
}

// ---------- Pengaturan, audit, notifikasi ----------

model Setting {
  key       String   @id
  value     String   @db.Text // JSON
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Pencacah atomik untuk nomor laporan per bulan (kunci: report:YYYYMM)
model Counter {
  key   String @id
  value Int    @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String?
  entityId  String?
  detail    String?  @db.Text // JSON
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
